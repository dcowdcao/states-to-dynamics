.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# PyTorch checkpoints / tensors — too large for git history
*.pt
*.pth

# Extracted activations (regenerated by extraction stage)
data/activations/*.pt

# Probe activations (large; copied by hand, not cloned — see MIGRATION.md)
analysis/linear_probe/activations/

# Interactive plots are large and regenerable — but the viewer's pages are source.
# Without these negations the deployed page silently vanishes from a commit.
*.html
!viewer/web/*.html
!viewer/static/*.html

# Exported browser weights (regenerate with spade.export.viewer_weights)
viewer/web/weights/

# SLURM job logs (transient; on disk / netscratch only)
logs/

# W&B run artifacts (training writes these into cwd)
wandb/

# Agent worktrees (transient; each is its own checkout)
.claude/worktrees/

# transient locks
*.lock

# Reduced probe-geometry runs; only a full run owns results/*.csv
analysis/probe_geometry/results/partial_*/
