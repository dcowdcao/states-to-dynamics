.DS_Store
**/.DS_Store

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# PyTorch checkpoints / tensors — too large for git history
*.pt
*.pth

# $SPADE_DATA_ROOT's default (spade.common.study): study trees and downloaded weights, never tracked
/data/

# Probe activations (large; copied by hand, not cloned — see MIGRATION.md)
analysis/linear_probe/activations/

# Interactive plots are large and regenerable — but the viewer's pages are source.
# Without these negations the deployed page silently vanishes from a commit.
*.html
!archive/viewer/web/*.html
!archive/viewer/static/*.html

# Exported browser weights (regenerate with the archived spade.export.viewer_weights)
archive/viewer/web/weights/

# SLURM job logs (transient; kept on cluster scratch only)
logs/

# W&B run artifacts (training writes these into cwd)
wandb/

# Agent worktrees (transient; each is its own checkout)
.claude/worktrees/

# transient locks
*.lock
!requirements.lock

# Build outputs. Owner scripts render and tabulate here; scripts/stage_figures.py copies the
# paper's 16 figures into figures/, and the tables the paper uses are written to results/.
/build/
analysis/**/figures/
analysis/**/results/
karvonen_othello_sweep/REPORT.md
karvonen_othello_sweep/best_per_type.csv
karvonen_othello_sweep/controls.csv
karvonen_othello_sweep/run_agreement.csv
