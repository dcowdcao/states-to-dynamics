# This cluster's settings. Private: the public export ships cluster.env.example in its place.
#
# Every .sbatch and run_*.sh loads this through cluster.sh. sbatch reads SBATCH_ACCOUNT /
# SBATCH_PARTITION as --account / --partition, so to submit a .sbatch by hand, source
# cluster.sh first; a -A / -p on the command line still wins.

export SBATCH_ACCOUNT=kempner_ba_lab
export SBATCH_PARTITION=kempner_h100
# CPU-only jobs: sbatch -A "$SPADE_CPU_ACCOUNT" -p "$SPADE_CPU_PARTITION" <script>
export SPADE_CPU_ACCOUNT=ba_lab
export SPADE_CPU_PARTITION=sapphire

module load python cuda/12.4.1-fasrc01
source activate spade_env
