# The cluster these jobs run on, in one place: edit it for yours.
#
# Every .sbatch sources this for its software stack, and every run_*.sh sources it before it
# submits. sbatch reads SBATCH_ACCOUNT / SBATCH_PARTITION as --account / --partition, so to
# submit a .sbatch by hand, source this first; a -A / -p on the command line still wins.

export SBATCH_ACCOUNT=kempner_ba_lab
export SBATCH_PARTITION=kempner_h100
# CPU-only jobs: sbatch -A "$SPADE_CPU_ACCOUNT" -p "$SPADE_CPU_PARTITION" <script>
export SPADE_CPU_ACCOUNT=ba_lab
export SPADE_CPU_PARTITION=sapphire

module load python cuda/12.4.1-fasrc01
source activate spade_env
