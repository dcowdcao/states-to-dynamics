# The cluster these jobs run on: copy this file to cluster.env and fill it in.
#
# Every .sbatch and run_*.sh loads cluster.env through cluster.sh. sbatch reads SBATCH_ACCOUNT /
# SBATCH_PARTITION as --account / --partition, so to submit a .sbatch by hand, source
# scripts/slurm/cluster.sh first; a -A / -p on the command line still wins.

export SBATCH_ACCOUNT=your_account
export SBATCH_PARTITION=your_gpu_partition
# CPU-only jobs: sbatch -A "$SPADE_CPU_ACCOUNT" -p "$SPADE_CPU_PARTITION" <script>
export SPADE_CPU_ACCOUNT=your_account
export SPADE_CPU_PARTITION=your_cpu_partition

# The software stack: the .venv that `make setup` builds. Add `module load` lines if your
# nodes need them.
source "$SPADE_REPO/.venv/bin/activate"
